# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_aggregator?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_TEAMS=3600
REDIS_CACHE_TTL_FIXTURES=300
REDIS_CACHE_TTL_STANDINGS=600

# Provider: footballdata.io v1 (Bearer auth)
# Docs: https://footballdata.io/documentation/endpoints/
FOOTBALL_DATA_API_KEY=your_footballdata_io_api_key
FOOTBALL_DATA_BASE_URL=https://footballdata.io/api/v1
FOOTBALL_DATA_TIMEOUT_MS=10000
# Find league_id via GET /leagues (e.g. 10 = Premier League in docs)
FOOTBALL_DATA_LEAGUE_ID=10
# Optional: filter by season_id from GET /leagues/{league_id}/seasons
# FOOTBALL_DATA_SEASON_ID=100

# Provider: SportMonks v3 football API
# Docs: https://docs.sportmonks.com/football/
SPORTMONKS_API_KEY=your_sportmonks_api_key
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_MS=10000

# Provider priority (comma-separated: footballData,sportmonks)
PROVIDER_PRIORITY=footballData,sportmonks

# SportMonks season/league id (see SportMonks dashboard)
DEFAULT_LEAGUE_ID=8

# BullMQ
SYNC_CRON_STANDINGS=0 */6 * * *
SYNC_CRON_FIXTURES=*/15 * * * *
SYNC_CRON_TEAMS=0 2 * * *
SYNC_CRON_IMAGES=0 3 * * *

# Image sync
IMAGE_SYNC_ENABLED=true
IMAGE_LOCAL_CACHE_PATH=./storage/images
