NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:root@localhost:5433/football_aggregator?schema=public
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_TEAMS=3600
REDIS_CACHE_TTL_FIXTURES=300
REDIS_CACHE_TTL_STANDINGS=600

FOOTBALL_DATA_API_KEY=fd_8f48c50af40d7d3b577cae18b432216a670d9db916ce0c32
FOOTBALL_DATA_BASE_URL=https://footballdata.io/api/v1
FOOTBALL_DATA_LEAGUE_ID=10
FOOTBALL_DATA_TIMEOUT_MS=10000

SPORTMONKS_API_KEY=QspavcewzNHtgNQcUmp6AyAT0no2kll0o7oe0iozTmSD3dMYvkYYFs1rWeqV
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_MS=10000

PROVIDER_PRIORITY=footballData,sportmonks
DEFAULT_COMPETITION_CODE=PL
DEFAULT_LEAGUE_ID=8
SYNC_CRON_STANDINGS=0 */6 * * *
SYNC_CRON_FIXTURES=*/15 * * * *
SYNC_CRON_TEAMS=0 2 * * *
SYNC_CRON_IMAGES=0 3 * * *
IMAGE_SYNC_ENABLED=true
IMAGE_LOCAL_CACHE_PATH=./storage/images
